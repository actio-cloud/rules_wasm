        "aarch64-linux": "sha384-3LKBz3VZ5x8lW699u74oAxbjjkNY8NBgD/IQl/ioTUM/L9oP5/JMkhEDUxL7njc2",
        "aarch64-macos": "sha384-uQY1QWXp/6dlCdxRMAg9DOhmKqQsfRMJOvjuGyrEnSQyXaR49EKO+Fc6xGB0t/xb",
        "x86_64-linux": "sha384-zUAnBb3a5P/iQBjAskKg2d1/Uw53dF+r7+j3wFqPN+vfZn5fXLLSjZNHh3GICrWh",
